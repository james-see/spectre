# Copy to .env and fill in (never commit .env)
WIFI_SSID=YourNetwork
WIFI_PASS=YourPassword

# Mac/PC running the sensing aggregator (LAN IP)
TARGET_IP=192.168.1.20
TARGET_PORT=5005

# Mesh size (Spectre ships as a 3-node triad by default)
TDM_TOTAL=3
ZONE=room
EDGE_TIER=2

# TP-Link Deco master (local admin API — Observatory LAN hotspots)
# Use a dedicated manager account if the Deco app is logged in as admin.
DECO_HOST=https://192.168.68.1
DECO_USER=admin
# Owner TP-Link ID password (username must stay "admin" for local API)
DECO_PASS=
DECO_BIND=127.0.0.1:3002
DECO_POLL_SECONDS=3
